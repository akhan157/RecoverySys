{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recoverysys.example/validation/corpus/schema.json",
  "title": "RecoverySys validation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "domain",
    "status",
    "inputs",
    "expected",
    "source",
    "model",
    "comparison",
    "notes"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "kind": { "enum": ["analytic", "trusted-simulator", "real-flight", "metamorphic"] },
    "domain": {
      "enum": [
        "atmosphere",
        "ascent",
        "descent",
        "drift",
        "landing-energy",
        "landing",
        "shock-load",
        "dispersion",
        "end-to-end",
        "mission-envelope",
        "hardware-fit",
        "deployment-plan",
        "loads",
        "brief",
        "other"
      ]
    },
    "status": { "enum": ["draft", "review", "accepted-for-comparison", "superseded", "rejected"] },
    "inputs": { "type": "object", "additionalProperties": true },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics"],
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value", "unit", "tolerance"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "value": {},
              "unit": { "type": "string", "minLength": 1 },
              "tolerance": {
                "type": "object",
                "additionalProperties": false,
                "required": ["basis"],
                "properties": {
                  "absolute": { "type": "number", "minimum": 0 },
                  "relative": { "type": "number", "minimum": 0 },
                  "basis": {
                    "enum": [
                      "source-stated",
                      "analyst-derived",
                      "engineering-judgment",
                      "not-applicable"
                    ]
                  }
                },
                "anyOf": [
                  { "required": ["absolute"] },
                  { "required": ["relative"] },
                  { "required": ["basis"] }
                ]
              },
              "notes": { "type": "string" }
            }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation", "derivation"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "accessed": { "type": "string", "format": "date" },
        "citation": { "type": "string", "minLength": 1 },
        "derivation": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string" },
        "artifactSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "notes": { "type": "string" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "assumptionsVersion", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "assumptionsVersion": { "type": "string", "minLength": 1 }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "decisionRule"],
      "properties": {
        "method": {
          "enum": ["absolute-and-relative", "absolute", "relative", "qualitative", "metamorphic"]
        },
        "decisionRule": { "type": "string", "minLength": 1 },
        "observed": { "type": "object", "additionalProperties": true },
        "reviewedBy": { "type": "string" },
        "reviewedAt": { "type": "string", "format": "date" }
      }
    },
    "notes": { "type": "string" }
  }
}
